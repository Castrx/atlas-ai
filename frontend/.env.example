# Alterna entre MockChatApi e RealChatApi no composition root (src/App.tsx).
# true  (padrão) -> MockChatApi, sem dependência do backend.
# false          -> RealChatApi, fala com o Atlas AI via /api/chat.
VITE_USE_MOCK_API=true

# Base URL da API usada por RealChatApi quando VITE_USE_MOCK_API=false.
# Em dev, "/api" é reescrito pelo proxy do Vite (ver vite.config.ts).
VITE_API_BASE_URL=/api
