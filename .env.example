# Copie este arquivo para .env e ajuste os valores conforme necessário.
# .env nunca deve ser commitado (ver .gitignore).

# Porta em que o servidor HTTP escuta
PORT=3000

# Ambiente de execução: development | test | production
NODE_ENV=development

# Chave da API da OpenAI. Obrigatória — a aplicação não sobe sem ela.
# NUNCA commite uma chave real aqui. Preencha apenas no seu .env local.
OPENAI_API_KEY=

# Modelo usado nas chamadas à OpenAI. Opcional — tem um default no código.
OPENAI_MODEL=gpt-4o-mini

# Integração real com o Atlas ERP (Fase 3b). Todas obrigatórias — a
# aplicação não sobe sem elas. NUNCA commite valores reais aqui.

# URL base da API do Atlas ERP (sem barra final), ex.: http://localhost:8080
ATLAS_ERP_BASE_URL=

# Credenciais de uma conta de serviço role USER do Atlas ERP (criada via
# POST /auth/register — que sempre cria USER, nunca ADMIN). Nunca use uma
# conta ADMIN aqui: as 6 tools são somente leitura e USER já é suficiente.
ATLAS_ERP_SERVICE_EMAIL=
ATLAS_ERP_SERVICE_PASSWORD=
